# Nginx Flow Manager — optional runtime environment variables.
# All have sensible defaults; copy to .env only to override them.

# NFM_PORT: TCP port the panel serves itself over HTTPS on. Default: 3000.
NFM_PORT=3000

# NFM_HOST: address the panel binds to. Default: 0.0.0.0 (all interfaces).
# Set to 127.0.0.1 when fronting the panel with a reverse proxy or running isolated.
NFM_HOST=0.0.0.0

# NODE_ENV: set to "production" to run the built server (dist/server.cjs) and
# enable the production static-file guards. Leave unset/development for `npm run dev`.
NODE_ENV=production
